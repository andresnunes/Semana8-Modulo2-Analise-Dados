# Perfil AWS REAL.
#
#   cp .env.aws.example .env.aws      e preencha os campos <...>
#   docker compose --env-file .env.aws up -d
#
# Repare no nome: .env.aws, NAO .env. O .env e versionado (perfil LocalStack);
# o .env.aws esta no .gitignore justamente porque leva credencial de verdade.
#
# Diferencas para o perfil LocalStack:
#   - a conexao NAO tem endpoint_url (senao o boto3 continua indo para o LocalStack)
#   - os nomes de bucket sao globais na AWS, entao levam um prefixo seu

AIRFLOW_UID=50000
AIRFLOW_PORT=8082

AIRFLOW_CONN_AWS_DEFAULT={"conn_type":"aws","login":"<ACCESS_KEY_ID>","password":"<SECRET_ACCESS_KEY>","extra":{"region_name":"us-east-1"}}

BUCKET_RAW=<seu-prefixo>-vendas-raw
BUCKET_CURATED=<seu-prefixo>-vendas-curated
BUCKET_ATHENA=<seu-prefixo>-athena-results
GLUE_DATABASE=vendas_db
GLUE_CRAWLER=vendas-crawler
GLUE_ROLE=arn:aws:iam::<ID_DA_CONTA>:role/AWSGlueServiceRole-vendas
