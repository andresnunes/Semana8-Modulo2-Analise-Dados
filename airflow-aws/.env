# Perfil LOCALSTACK (padrao). Para apontar para a AWS de verdade,
# copie .env.aws.example por cima deste arquivo e preencha as credenciais.

AIRFLOW_UID=50000

# Porta da interface. Troque se 8082 ja estiver ocupada na sua maquina.
AIRFLOW_PORT=8082

# Conexao AWS do Airflow. O endpoint_url e o que redireciona o boto3 para o LocalStack.
AIRFLOW_CONN_AWS_DEFAULT={"conn_type":"aws","login":"test","password":"test","extra":{"region_name":"us-east-1","endpoint_url":"http://localstack:4566"}}

BUCKET_RAW=vendas-raw
BUCKET_CURATED=vendas-curated
BUCKET_ATHENA=athena-results
GLUE_DATABASE=vendas_db
GLUE_CRAWLER=vendas-crawler
GLUE_ROLE=arn:aws:iam::000000000000:role/AWSGlueServiceRole-vendas
